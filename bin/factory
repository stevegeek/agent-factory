    p.add_argument("question", nargs="+")
    p = sub.add_parser("reply")
    p.add_argument("ticket")
    p.add_argument("text", nargs="+")
    sub.add_parser("wake")
    sub.add_parser("migrate")
    sub.add_parser("tick")
    sub.add_parser("sweep")
    sub.add_parser("clock")
    sub.add_parser("rebuild")
    sub.add_parser("versions")
    sub.add_parser("check")
    p = sub.add_parser("ticket")
    p.add_argument("verb", choices=list(TICKET_VERBS))
    p.add_argument("args", nargs="*")
    p.add_argument("--as", dest="as_name", metavar="NAME", help="act as this token (default: the maintainer)")
    p.add_argument("--wait", type=float, default=CLI_WAIT, help="seconds to wait for a ticket's lock")
