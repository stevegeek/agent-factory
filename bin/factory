    p.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "ticket" and a.json:
        return ticket_json(a)
    cfg = {} if a.cmd == "model" else load_config()
    {"check": cmd_check, "ticket": cmd_ticket, "tokens": cmd_tokens, "add": cmd_add, "result": cmd_result, "approve": cmd_approve, "redirect": cmd_redirect, "host": cmd_host, "ls": cmd_ls, "recipes": cmd_recipes, "show": cmd_show, "model": cmd_model, "look": cmd_look, "audit": cmd_audit, "memory": cmd_memory, "proposals": cmd_proposals, "pr": cmd_pr, "github": cmd_github, "gate-workflow": cmd_gate_workflow, "move": cmd_move, "note": cmd_note, "ask": cmd_ask, "reply": cmd_reply, "wake": lambda c, _: wake(), "merge": cmd_merge,
     "migrate": lambda c, _: migrate(),
     "tick": lambda c, _: tick(c), "sweep": lambda c, _: sweep(c),
     "clock": lambda c, _: clock(c), "rebuild": lambda c, _: rebuild(c),
     "versions": lambda c, _: check_versions(c)}[a.cmd](cfg, a)


if __name__ == "__main__":
    main()
