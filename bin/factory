    p.add_argument("--intent", action="store_true",
                   help="an idea to design first: a designer proposes, you `factory approve` or `redirect`")
    p.add_argument("--manage", action="store_true",
                   help=f"a request for the manager (project {NOTICE_PROJECT}): it answers and drafts config changes for you")
