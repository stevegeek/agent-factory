    p = sub.add_parser("look")
    p.add_argument("ticket")
    p.add_argument("--lines", type=int, default=120)
    sub.add_parser("audit").add_argument("ticket")
    p = sub.add_parser("memory")
    p.add_argument("project", nargs="?")
    p.add_argument("role", nargs="?")
    p.add_argument("--revert", metavar="COMMIT")
    sub.add_parser("proposals")
    sub.add_parser("pr").add_argument("ticket")
    sub.add_parser("github")
    sub.add_parser("gate-workflow").add_argument("project")
    p = sub.add_parser("move")
    p.add_argument("ticket")
    p.add_argument("column")
    p.add_argument("--note")
    p = sub.add_parser("note")
    p.add_argument("ticket")
    p.add_argument("text", nargs="+")
    sub.add_parser("merge").add_argument("ticket")
