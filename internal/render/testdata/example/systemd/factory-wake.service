# The tick Foreman's wake starts (factory-wake.path), as a user unit of the factory user, in its
# own slice and outside Foreman's sandbox. A tick already running holds the tick lock: this one
# then leaves .tick.again, and the running tick goes round again.
[Unit]
Description=Agent factory: a tick Foreman asked for

[Service]
Type=oneshot
ExecStart=%h/factory/bin/factory tick
TimeoutStartSec=45min
Nice=5
