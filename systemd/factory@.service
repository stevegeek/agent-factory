[Unit]
Description=Agent factory: %i
After=network-online.target user@{{factory_uid}}.service
Wants=network-online.target

[Service]
Type=oneshot
User={{factory_user}}
Group={{factory_user}}
Environment=XDG_RUNTIME_DIR=/run/user/{{factory_uid}}
# lets rootless podman create containers through factory's own systemd, so they
# land in user-{{factory_uid}}.slice and its shared memory budget
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{factory_uid}}/bus
WorkingDirectory={{factory_home}}
ExecStart={{factory_root}}/bin/factory %i
TimeoutStartSec=45min
Nice=5
